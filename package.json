{
  "name": "@kingychiu/opencode-model-fallback",
  "version": "1.1.3",
  "description": "Mapped model fallback router with reasoning-variant preservation and a TUI activity dashboard for OpenCode V2.",
  "keywords": [
    "fallback",
    "model",
    "opencode",
    "plugin",
    "router",
    "tui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingychiu/opencode-model-fallback.git"
  },
  "files": [
    "index.js",
    "tui.js",
    "rpc.js",
    "lib"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "import": "./index.js"
    },
    "./tui": {
      "import": "./tui.js"
    },
    "./rpc": {
      "import": "./rpc.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "npx oxlint .",
    "fmt": "npx oxfmt --check .",
    "fmt:fix": "npx oxfmt --write .",
    "check": "npm run test && npm run lint && npm run fmt",
    "prepack": "npm run check",
    "test:e2e": "OPENCODE_E2E=1 vitest run test/e2e.fallback.test.js"
  },
  "dependencies": {
    "@opencode/plugin": "2.3.2",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@opencode/client": "^2.3.2",
    "@opentui/core": "0.9.5",
    "@opentui/solid": "0.9.5",
    "oxfmt": "0.50.0",
    "oxlint": "1.65.0",
    "solid-js": ">=1.9.0",
    "vitest": "4.1.6"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.9.5",
    "@opentui/solid": ">=0.9.5",
    "solid-js": ">=1.9.0"
  }
}
